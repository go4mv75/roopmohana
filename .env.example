# ─────────────────────────────────────────────────────────────
# Roop Mohana store — environment variables
# Copy to .env.local for local development. On Vercel/Render/etc.
# set these in the project's Environment Variables settings.
# ─────────────────────────────────────────────────────────────

# ── Required in production ──────────────────────────────────
# Public URL of the site (no trailing slash). Used for payment redirects,
# emails, sitemap and Google sign-in.
NEXT_PUBLIC_SITE_URL=https://roopmohana.com

# Postgres connection string (Neon, Supabase, Railway, RDS…).
# Leave unset locally to use the built-in embedded database in ./.data
DATABASE_URL=

# Long random string used to sign login sessions. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# ── Owner account (used by `npm run db:seed`) ───────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: comma-separated emails that become owner when they
# sign in with Google (Google verifies the address).
ADMIN_EMAILS=

# ── Payments: Razorpay (cards, UPI, netbanking, wallets) ────
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL: https://<site>/api/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ── Payments: PhonePe PG (UPI collect / intent, Swiggy-style) ─
# PhonePe Business dashboard → Developer settings.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# "sandbox" (default) or "production"
PHONEPE_ENV=sandbox
# Webhook URL: https://<site>/api/webhooks/phonepe — set the same
# username/password in the PhonePe dashboard.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ── Payments: direct UPI (zero fee, owner verifies in bank app) ─
# Use a business/merchant VPA. Leave empty to hide this option.
UPI_VPA=
UPI_PAYEE_NAME=Roop Mohana

# ── Cash on delivery ────────────────────────────────────────
COD_ENABLED=false
COD_FEE=49

# ── Shipping (rupees) ───────────────────────────────────────
FREE_SHIPPING_ABOVE=1000
SHIPPING_FEE=79

# ── Email (order confirmations, password resets) ───────────
# https://resend.com — verify your domain, then create an API key.
RESEND_API_KEY=
MAIL_FROM=Roop Mohana <orders@roopmohana.com>
# Where new-order and enquiry alerts go
OWNER_NOTIFY_EMAIL=

# ── Google sign-in (optional) ───────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI: https://<site>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Image uploads ───────────────────────────────────────────
# On Vercel: create a Blob store (Storage tab) — this is set automatically.
BLOB_READ_WRITE_TOKEN=
# Self-hosted: where uploads are stored (default ./.data/uploads)
UPLOAD_DIR=

# ── Store details shown on the site ─────────────────────────
NEXT_PUBLIC_STORE_EMAIL=info@roopmohana.com
NEXT_PUBLIC_STORE_PHONE=+91 86999 64258
NEXT_PUBLIC_STORE_WHATSAPP=918699964258
NEXT_PUBLIC_STORE_ADDRESS=

# ── Local development only ──────────────────────────────────
# Simulates Razorpay/PhonePe so you can test checkout without keys.
# Ignored when NODE_ENV=production.
PAYMENTS_MOCK=false
